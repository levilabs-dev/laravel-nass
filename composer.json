{
    "name": "levilabs/laravel-nass",
    "description": "Modern Laravel SDK for NASS E-Payment Gateway and Nass Wallet: portal checkout, status polling, notify callbacks, and wallet checkout for Iraq.",
    "keywords": [
        "laravel",
        "nass",
        "nasswallet",
        "payment",
        "gateway",
        "iraq",
        "iqd",
        "levilabs"
    ],
    "homepage": "https://levilabs.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/levilabs-dev/laravel-nass/issues",
        "source": "https://github.com/levilabs-dev/laravel-nass",
        "docs": "https://github.com/levilabs-dev/laravel-nass#readme",
        "security": "https://github.com/levilabs-dev/laravel-nass/security"
    },
    "authors": [
        {
            "name": "Levi Labs",
            "email": "hello@levilabs.dev",
            "homepage": "https://levilabs.dev",
            "role": "Organization"
        },
        {
            "name": "Nizam Omer",
            "email": "nizam@nizaamomer.com",
            "homepage": "https://nizaamomer.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.4",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.1"
    },
    "autoload": {
        "psr-4": {
            "LeviLabs\\LaravelNass\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeviLabs\\LaravelNass\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "LeviLabs\\LaravelNass\\NassServiceProvider"
            ],
            "aliases": {
                "NassGatewayAuth": "LeviLabs\\LaravelNass\\Facades\\NassGatewayAuth",
                "NassGatewayPayment": "LeviLabs\\LaravelNass\\Facades\\NassGatewayPayment",
                "NassWalletAuth": "LeviLabs\\LaravelNass\\Facades\\NassWalletAuth",
                "NassWalletPayment": "LeviLabs\\LaravelNass\\Facades\\NassWalletPayment"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
